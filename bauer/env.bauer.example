# Bauer overlay for .env — decisions from bauer-automate/claude-skills#903, #933.
# Copy the values you need into the repo-root .env (gitignored). Placeholders only here.

# --- Identity (#903) ---------------------------------------------------------
# Two Entra app registrations. The ENGINE uses the service app and signs in as a
# DEDICATED SERVICE ACCOUNT, never as a person: its Graph reach is then that
# account's reach, scoped with ordinary M365 controls. The authority gates are
# application logic, not a security boundary.
# READ SCOPES ONLY for the first deployment. If a gate is the only thing between
# the Executive and an outbound email, one prompt-level failure sends it. If
# Mail.Send was never granted, the same failure returns 403.
# Run: npx @softeria/ms-365-mcp-server --org-mode --list-permissions
# then cut the result to reads before taking it to admin consent.
MS365_MCP_CLIENT_ID=
MS365_MCP_CLIENT_SECRET=
MS365_MCP_TENANT_ID=

# Required, no default — the app refuses to start without it. Must be the
# service account, not a person.
EXEC_EMAIL_ADDRESS=

# --- Reachability (#933) -----------------------------------------------------
# Set the moment anything can reach this from outside the box.
OE_PUBLIC_DEPLOYMENT=1
BACKEND_SHARED_SECRET=          # openssl rand -hex 32 — same value on API and UI
BACKEND_ALLOWED_ORIGINS=        # https://<public-ui-host>, exact scheme and host
AUTH_URL=                       # https://<public-ui-host>
AUTH_TRUST_HOST=true
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=                 # explicit list; a valid Google login not listed is rejected

# Web UI keeps GOOGLE sign-in deliberately. Entra identity arrives through the
# Copilot Studio surface, not by swapping the Auth.js provider — that would edit
# packages/ui/src/auth.ts, a file upstream also touches (#897).

# --- Posture (#933) ----------------------------------------------------------
ALERT_REVIEW_MAX_MOVES_PER_SCAN=0   # annotate only; no routing, no DMs

# --- Cost knobs --------------------------------------------------------------
ALERT_REVIEW_INTERVAL_HOURS=6
WATCHLIST_RESEARCH_INTERVAL_MINUTES=360
ENABLE_WEB_SEARCH=false
ENABLE_CACHING=true             # leave on: breaking prompt caching is ~10x cost
# CLIENT_ROTATION_ENABLED=      # leave off; one LLM bill per client per night

# --- Not used by Bauer -------------------------------------------------------
# Slack, Discord, Telegram, Google Chat: Bauer runs Teams. The Teams surface
# comes from Copilot Studio calling OpenExecutive's /mcp endpoint (#897), not
# from a chat integration in this repo.
