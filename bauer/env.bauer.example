# Bauer overlay for .env. Copy the values you need into the repo-root .env
# (gitignored). Placeholders only here.
#
# Rationale for these choices lives in Bauer's internal tracker, not in this
# public repo. What follows is configuration, not reasoning.

# --- Identity ---------------------------------------------------------------
# Two Entra app registrations. The engine uses the service app and signs in as a
# dedicated service account, not as a person.
#
# READ SCOPES ONLY for the first deployment.
#
# Run: npx @softeria/ms-365-mcp-server --org-mode --list-permissions
# then cut the result to reads before taking it to admin consent.
MS365_MCP_CLIENT_ID=
MS365_MCP_CLIENT_SECRET=
MS365_MCP_TENANT_ID=

# Required, no default — the app refuses to start without it. Set to the service
# account, not a person.
EXEC_EMAIL_ADDRESS=

# --- Reachability -----------------------------------------------------------
# Set these the moment anything can reach this instance from outside its host.
OE_PUBLIC_DEPLOYMENT=1
BACKEND_SHARED_SECRET=          # openssl rand -hex 32 — same value on API and UI
BACKEND_ALLOWED_ORIGINS=        # https://<public-ui-host>, exact scheme and host
AUTH_URL=                       # https://<public-ui-host>
AUTH_TRUST_HOST=true
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=                 # explicit list

# NOTE (upstream change, unverified here): upstream now unions ALLOWED_EMAILS
# with the People roster rather than treating it as the whole allowlist. Confirm
# the current behaviour before relying on this being an exclusive list.

# The web UI keeps its Google sign-in provider deliberately. Swapping it would
# edit packages/ui/src/auth.ts, a file upstream also touches.

# --- Alert review -----------------------------------------------------------
ALERT_REVIEW_MAX_MOVES_PER_SCAN=0   # annotate only; no routing, no DMs

# --- Cost knobs -------------------------------------------------------------
ALERT_REVIEW_INTERVAL_HOURS=6
WATCHLIST_RESEARCH_INTERVAL_MINUTES=360
ENABLE_WEB_SEARCH=false
ENABLE_CACHING=true             # leave on: breaking prompt caching is ~10x cost
# CLIENT_ROTATION_ENABLED=      # leave off; one LLM bill per client per night

# --- Unused here ------------------------------------------------------------
# Slack, Discord, Telegram and Google Chat integrations are not configured.
